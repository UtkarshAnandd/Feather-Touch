# ─────────────────────────────────────────────────────────────────────────────
# Feather Touch — environment variables (documentation template)
#
# Copy to `.env` for local development:   cp .env.example .env
#
# RULES
# - NOTHING here is required to run `next build` or to render the public site
#   shell. Each server feature validates ONLY its own variables, at the moment
#   that feature is invoked (see lib/server/env.ts). Missing values produce an
#   error naming the variable — never its value.
# - Only variables prefixed NEXT_PUBLIC_ are ever sent to the browser, and they
#   are inlined at BUILD time. Never put a secret in a NEXT_PUBLIC_ variable.
# - Real production values live in Vercel project settings, never in git.
# - Values shown below are LOCAL DOCKER defaults (docker-compose.yml) or blanks.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site mode ────────────────────────────────────────────────────────────────
# "preview" (default): noindex everywhere, preview banner shown.
# "production": indexable. Only set after the launch gate passes.
SITE_MODE=preview

# Public canonical origin (no trailing slash). Inlined into the client bundle.
# Leave blank until the school's domain is confirmed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Neon PostgreSQL in production) ────────────────────────────────
# Runtime connection. On Neon use the POOLED connection string.
DATABASE_URL=postgresql://feather:feather_local_only@127.0.0.1:54329/feather_touch
# Migrations. On Neon use the DIRECT (non-pooled) connection string.
DIRECT_URL=postgresql://feather:feather_local_only@127.0.0.1:54329/feather_touch
# Only needed for `prisma migrate dev` / drift checks.
SHADOW_DATABASE_URL=postgresql://feather:feather_local_only@127.0.0.1:54329/feather_touch_shadow
# Integration tests only (wiped and re-migrated by the test setup).
TEST_DATABASE_URL=postgresql://feather:feather_local_only@127.0.0.1:54329/feather_touch_test

# ── Admin authentication (better-auth) ──────────────────────────────────────
# ≥ 32 random characters. Generate:  openssl rand -base64 48
BETTER_AUTH_SECRET=
# Absolute origin that serves /api/auth (same as the site origin).
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra trusted origins (e.g. a Vercel preview domain). Optional.
BETTER_AUTH_TRUSTED_ORIGINS=
# Admins must enrol TOTP 2FA before reaching any admin screen other than
# /admin/account. Keep "true" outside local development.
ADMIN_REQUIRE_2FA=true

# ── Security helpers ────────────────────────────────────────────────────────
# Salt for hashing client IPs (enquiries/audit). ≥ 32 random characters.
IP_HASH_SALT=
# HMAC secret for the enquiry form anti-bot timestamp token. ≥ 32 characters.
FORM_TOKEN_SECRET=
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Media storage (Cloudflare R2 in production; MinIO locally) ──────────────
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=auto
STORAGE_BUCKET=feather-touch-media
STORAGE_ACCESS_KEY_ID=feather_minio
STORAGE_SECRET_ACCESS_KEY=feather_minio_local_only
# Public CDN origin that serves the media/ prefix (R2 custom domain). Not a secret.
NEXT_PUBLIC_MEDIA_BASE_URL=

# ── Email (Resend in production; Mailpit locally) ───────────────────────────
# memory  : in-process capture (tests)
# mailpit : POSTs to the local Mailpit HTTP API (local dev; nothing is delivered)
# resend  : production — NOT CONNECTED in Phase 1A (selecting it throws)
EMAIL_PROVIDER=mailpit
MAILPIT_API_URL=http://127.0.0.1:8025
EMAIL_FROM=
# Comma-separated school inbox(es) that receive new-enquiry alerts.
ENQUIRY_NOTIFY_EMAILS=
RESEND_API_KEY=

# ── WhatsApp (official Meta WhatsApp Business Cloud API only) ────────────────
# memory    : in-process capture (tests)
# log       : records the would-be message in server logs, sends nothing (local dev)
# meta_cloud: production — NOT CONNECTED in Phase 1A (selecting it throws)
# Unofficial automation libraries are prohibited.
WHATSAPP_PROVIDER=log
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_ENQUIRY=
WHATSAPP_TEMPLATE_LANG=
# E.164 digits of the SCHOOL STAFF number that receives enquiry alerts.
WHATSAPP_NOTIFY_TO=

# ── Notification kill switches ──────────────────────────────────────────────
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_WHATSAPP_ENABLED=false

# NOTE: The PUBLIC WhatsApp CTA number + prefilled message are school facts,
# stored in the database (SiteSettings), not here. They stay empty until the
# school supplies them; the CTA is hidden while empty.
